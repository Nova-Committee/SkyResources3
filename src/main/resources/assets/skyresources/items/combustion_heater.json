{
  "model": {
    "type": "minecraft:select",
    "property": "skyresources:combustion_heater_type",
    "cases": [
      {
        "when": ["skyresources:wooden"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/wooden_combustion_heater" }
      },
      {
        "when": ["skyresources:stone"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/stone_combustion_heater" }
      },
      {
        "when": ["skyresources:iron"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/iron_combustion_heater" }
      },
      {
        "when": ["skyresources:nether_brick"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/nether_brick_combustion_heater" }
      },
      {
        "when": ["skyresources:end_stone"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/end_stone_combustion_heater" }
      },
      {
        "when": ["skyresources:dark_matter"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/dark_matter_combustion_heater" }
      },
      {
        "when": ["skyresources:light_matter"],
        "model": { "type": "minecraft:model", "model": "skyresources:block/light_matter_combustion_heater" }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "skyresources:block/iron_combustion_heater"
    }
  }
}
