{
  "itemGroup.skyresources.main": "SkyResources3",
  "generator.skyresources.void_island": "空岛",
  "guide.skyresources.stage1": "阶段 1",
  "guide.skyresources.stage2": "阶段 2",
  "guide.skyresources.stage3": "阶段 3",
  "guide.skyresources.stage4": "阶段 4",
  "guide.skyresources.stage1.stage1.title": "阶段 1 - 基础生存",
  "guide.skyresources.stage1.stage1.text": "先选择一条岛屿路线，然后逐步推进到生命灌注、切割工具、食物和第一批可再生资源。选择路线：{action:1} {action:2} {action:3} {action:4} {action:5}",
  "guide.skyresources.stage1.sandIsland.title": "沙漠岛",
  "guide.skyresources.stage1.sandIsland.text": "沙漠路线从仙人掌和红沙开始。保存好初始材料，从仙人掌获取早期炼金组件，制作切割刀，然后用生命灌注获得树苗和泥土。",
  "guide.skyresources.stage1.lifeInfusion.title": "生命灌注",
  "guide.skyresources.stage1.lifeInfusion.text": "灌注石会消耗玩家生命值和耐久来转化方块。副手物品、目标方块和所需生命值来自灌注配方，后续可用生命灌注器自动化。",
  "guide.skyresources.stage1.knife.title": "切割刀",
  "guide.skyresources.stage1.knife.text": "切割刀可将指定方块破坏为特殊掉落物。仙人掌、石质、铁制和钻石切割刀面向玩家的用途相同，材料越强耐久越高。",
  "guide.skyresources.stage1.snowIsland.title": "雪原岛",
  "guide.skyresources.stage1.snowIsland.text": "雪原路线先收集雪球、建造雪傀儡，并使用迷你冰箱制作重型雪球和重型雪球，再推进到泥土和树苗。",
  "guide.skyresources.stage1.freezer.title": "冰箱",
  "guide.skyresources.stage1.freezer.text": "冰箱会将输入物品转换为冷冻产物。用 {action:1} 和 {action:3} 打开不同等级配方，用 {action:2} 查看冷冻处理，或用 {action:4} 查看铁制冰箱结构。迷你、铁制和亮物质等级拥有不同速度和槽位数量；铁制与亮物质冰箱是双方块机器，控制器位于下方。",
  "guide.skyresources.stage1.heavySnowball.title": "重型雪球",
  "guide.skyresources.stage1.heavySnowball.text": "当雪是你的主要资源路线时，重型雪球和爆炸重型雪球能提供早期远程伤害。",
  "guide.skyresources.stage1.woodIsland.title": "木岛",
  "guide.skyresources.stage1.woodIsland.text": "木岛路线围绕生存者钓竿展开。通过钓鱼获取有用杂物、泥土和树苗，直到能够进入阶段 2 的资源机器。",
  "guide.skyresources.stage1.survFish.title": "生存者钓竿",
  "guide.skyresources.stage1.survFish.text": "生存者钓竿是一根便宜耐用的钓竿，偏向钓出杂物和少量有用收获。泥土和原版树苗是最重要的早期奖励。",
  "guide.skyresources.stage1.grassIsland.title": "草地岛",
  "guide.skyresources.stage1.grassIsland.text": "草地岛更接近阶段 2，因为它已经拥有泥土和树木来源。想跳过大部分基础生存启动流程时可以选择它。",
  "guide.skyresources.stage1.magmaIsland.title": "岩浆岛",
  "guide.skyresources.stage1.magmaIsland.text": "岩浆岛是困难开局。谨慎使用石化木，从岩浆石和水晶流体生成圆石，然后推进到氧化工艺和融合台。",
  "guide.skyresources.stage1.magmaStone.title": "岩浆石",
  "guide.skyresources.stage1.magmaStone.text": "岩浆石会检查相邻的水晶流体并可能生成圆石。周围更多侧面接触水晶流体，会增加每刻触发的机会次数。",
  "guide.skyresources.stage2.stage2.title": "阶段 2 - 资源生产",
  "guide.skyresources.stage2.stage2.text": "阶段 2 引入大部分资源生产循环。先了解框架、热源、融合、坩埚、冷凝器和早期自动化，再推进到高级机器。",
  "guide.skyresources.stage2.seeds.title": "种子",
  "guide.skyresources.stage2.seeds.text": "原版种子和作物起步物可通过草方块进度产出。这样岛屿开局就不依赖自然生成的村庄或地形。",
  "guide.skyresources.stage2.casing.title": "框架",
  "guide.skyresources.stage2.casing.text": "框架可承载氧化加热器、热量供应器和冷凝器。将机器物品插入外壳，潜行交互可将其取出，并根据不同热量行为选择外壳等级。",
  "guide.skyresources.stage2.combustionHeater.title": "氧化加热器",
  "guide.skyresources.stage2.combustionHeater.text": "氧化加热器安装在框架中，可在有效多方块结构内合成掉落的物品组。更高等级会改变燃料、速度、效率和允许的结构方块。",
  "guide.skyresources.stage2.waterExtractor.title": "抽水器",
  "guide.skyresources.stage2.waterExtractor.text": "抽水器可储水、从方块中抽水、放置水源，并向兼容目标注水。后续水相机器会自动化同类水流操作。",
  "guide.skyresources.stage2.dirtFurnace.title": "泥炉",
  "guide.skyresources.stage2.dirtFurnace.text": "泥炉可在稳定圆石生成器或普通熔炉路线可用前提供早期烧炼能力。",
  "guide.skyresources.stage2.lavaBlaze.title": "熔岩与烈焰粉块",
  "guide.skyresources.stage2.lavaBlaze.text": "烈焰粉块从下方受热时会生成熔岩。这是在完整坩埚自动化前通向圆石生成器的早期路线之一。",
  "guide.skyresources.stage2.heatSources.title": "热源",
  "guide.skyresources.stage2.heatSources.text": "热源会加热坩埚和烈焰粉块等方块。燃料型热量供应器在外壳机器可用后会成为更强热源。",
  "guide.skyresources.stage2.heatProvider.title": "热量供应器",
  "guide.skyresources.stage2.heatProvider.text": "热量供应器是安装在外壳中的热源。其等级决定燃料类型、效率和热量值，并且可被红石禁用。",
  "guide.skyresources.stage2.rockGrinder.title": "碎石杵",
  "guide.skyresources.stage2.rockGrinder.text": "碎石杵会将类似石头的方块破碎为砂砾、沙子、粉碎的石头、粉碎下界岩及相关处理资源。碎石机自动化建立在此行为之上。",
  "guide.skyresources.stage2.metalCreation.title": "金属制造",
  "guide.skyresources.stage2.metalCreation.text": "金属生产结合了 {action:1}、{action:2}、{action:3} 和 {action:4}。矿石炼金矿尘与水晶流体驱动锭循环；使用 {action:5} 预览基础结构。",
  "guide.skyresources.stage2.crucible.title": "坩埚",
  "guide.skyresources.stage2.crucible.text": "坩埚会在下方受热时将指定物品熔化为流体。坩埚投料器和漏液器可自动化输入与输出侧。",
  "guide.skyresources.stage2.fluidDropper.title": "漏液器",
  "guide.skyresources.stage2.fluidDropper.text": "漏液器会从相邻储罐抽取流体，并在流体足够时在下方放置源方块，因此适合自动化坩埚输出。",
  "guide.skyresources.stage2.fusionTable.title": "融合台",
  "guide.skyresources.stage2.fusionTable.text": "炼金灌注台会使用物品输入和催化剂合成炼金配方。手动放入的槽位内容也会作为自动化过滤器。",
  "guide.skyresources.stage2.condenser.title": "冷凝器",
  "guide.skyresources.stage2.condenser.text": "冷凝器安装在外壳中，使用物品催化剂（通常是矿石炼金矿尘）冷凝上方方块，并将结果输出到下方或物品栏中。",
  "guide.skyresources.stage2.crucibleInserter.title": "坩埚投料器",
  "guide.skyresources.stage2.crucibleInserter.text": "坩埚投料器通过自身物品栏和物品自动化访问，将物品自动插入附近坩埚。",
  "guide.skyresources.stage2.combustionCollector.title": "氧化收集器",
  "guide.skyresources.stage2.combustionCollector.text": "氧化收集器会捕获氧化合成结果，避免物品阻塞结构中的重复合成。",
  "guide.skyresources.stage2.crushedStone.title": "粉碎的石头",
  "guide.skyresources.stage2.crushedStone.text": "粉碎的石头和粉碎下界岩可通过炼药锅或洗矿机处理，产出矿石粉路线。",
  "guide.skyresources.stage2.gemProduction.title": "宝石生产",
  "guide.skyresources.stage2.gemProduction.text": "肮脏宝石来自岩石研磨，并可通过水处理清洗为可用宝石。洗矿机自动化会改进同一流程。",
  "guide.skyresources.stage2.wildlifeAttractor.title": "野生动物吸引器",
  "guide.skyresources.stage2.wildlifeAttractor.text": "野生动物吸引器消耗能量、水和自然物质时间，在方块上方生成被动动物，并且红石可禁用它。",
  "guide.skyresources.stage3.stage3.title": "阶段 3 - 高级自动化",
  "guide.skyresources.stage3.stage3.text": "阶段 3 使用自动化方块和更智能的机器改进早期生产。这些工具会减少手动丢物品、清洗、粉碎和水处理操作。",
  "guide.skyresources.stage3.quickDropper.title": "快速漏斗",
  "guide.skyresources.stage3.quickDropper.text": "快速漏斗无需红石脉冲即可投出整组物品，受红石供能时会停止，因此适合受控机器输入。",
  "guide.skyresources.stage3.rockCrusher.title": "碎石机",
  "guide.skyresources.stage3.rockCrusher.text": "碎石机会消耗 FE 自动执行岩石研磨配方，并提供更高产出倍率。",
  "guide.skyresources.stage3.rockCleaner.title": "洗矿机",
  "guide.skyresources.stage3.rockCleaner.text": "洗矿机会自动化水炼药锅清洗配方，消耗水和 FE，并提升产出。",
  "guide.skyresources.stage3.combustionController.title": "智能氧化控制器",
  "guide.skyresources.stage3.combustionController.text": "智能氧化控制器会根据优先过滤器自动化氧化合成，并可将结果传递给氧化收集器。",
  "guide.skyresources.stage3.aqueous.title": "水相机器",
  "guide.skyresources.stage3.aqueous.text": "自动注水器和自动抽水器会自动化抽水器风格的注水与抽水行为，用于水处理装置。",
  "guide.skyresources.stage4.stage4.title": "阶段 4 - 强力材料",
  "guide.skyresources.stage4.stage4.text": "阶段 4 专注于暗物质、亮物质、更强自动化、进入末地和基于生命的机器。",
  "guide.skyresources.stage4.integratedDynamics.title": "Integrated Dynamics 支持",
  "guide.skyresources.stage4.integratedDynamics.text": "当加载 Integrated Dynamics 时，SkyResources3 会为门瑞尔浆果和门瑞尔树苗添加生命灌注配方。使用 {action:1} 打开灌注配方。用红蘑菇灌注淡蓝色染料得到浆果，再用白桦树苗灌注这些浆果得到树苗。",
  "guide.skyresources.stage4.dmWarper.title": "暗物质生物转化装置",
  "guide.skyresources.stage4.dmWarper.text": "暗物质生物转化装置消耗暗物质燃料来转化附近生物，并可根据配置选择是否影响玩家或动物。",
  "guide.skyresources.stage4.end.title": "末地",
  "guide.skyresources.stage4.end.text": "末地传送门核心使用多方块结构、末影之眼物品栏和红石脉冲将玩家传送到末地。用 {action:1} 打开核心配方，用 {action:2} 预览结构，然后继续查看改进版传送门 {action:3}。",
  "guide.skyresources.stage4.end2.title": "末地 - 改进版",
  "guide.skyresources.stage4.end2.text": "改进版末地传送门核心结构加入蠹虫干扰器、亮物质块、末地烛和紫珀柱，以移除末影之眼消耗和蠹虫骚扰。",
  "guide.skyresources.stage4.healthGem.title": "生命宝石",
  "guide.skyresources.stage4.healthGem.text": "生命宝石会储存灌注生命值，随时间提升最大生命值，并为生命灌注器自动化提供储存生命。",
  "guide.skyresources.stage4.lifeInfuser.title": "生命灌注器",
  "guide.skyresources.stage4.lifeInfuser.text": "生命灌注器可用多方块结构自动执行 {action:1}，并使用 {action:2}、副手物品和核心下方的目标方块。用 {action:3} 打开核心配方，或用 {action:4} 预览结构。",
  "guide.skyresources.stage4.lifeInjector.title": "生命汲取器",
  "guide.skyresources.stage4.lifeInjector.text": "生命汲取器会伤害站在其上的实体，并将这些生命储存在生命宝石中以供后续灌注使用。",
