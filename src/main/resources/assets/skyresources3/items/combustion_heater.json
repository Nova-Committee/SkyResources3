{
  "model": {
    "type": "minecraft:select",
    "property": "skyresources3:combustion_heater_type",
    "cases": [
      {
        "when": ["skyresources3:wooden"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/wooden_combustion_heater" }
      },
      {
        "when": ["skyresources3:stone"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/stone_combustion_heater" }
      },
      {
        "when": ["skyresources3:iron"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/iron_combustion_heater" }
      },
      {
        "when": ["skyresources3:nether_brick"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/nether_brick_combustion_heater" }
      },
      {
        "when": ["skyresources3:end_stone"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/end_stone_combustion_heater" }
      },
      {
        "when": ["skyresources3:dark_matter"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/dark_matter_combustion_heater" }
      },
      {
        "when": ["skyresources3:light_matter"],
        "model": { "type": "minecraft:model", "model": "skyresources3:block/light_matter_combustion_heater" }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "skyresources3:block/iron_combustion_heater"
    }
  }
}
